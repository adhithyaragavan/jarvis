# ---------- Server ----------
PORT=3000
# IANA timezone used for calendar events (defaults to the machine's timezone)
# TIMEZONE=Asia/Kolkata

# ---------- AI core ----------
# Set ONE of these. Without a key JARVIS falls back to its built-in rule-based parser.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=            (optional; auto-picks the newest Flash model)
ANTHROPIC_API_KEY=
# JARVIS_MODEL=claude-opus-5-5

# ---------- Google Calendar + Drive ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ---------- Telegram ----------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Optional: your own chat ID — JARVIS will ping you on Telegram when reminders are due.
TELEGRAM_OWNER_CHAT_ID=

# ---------- Behaviour ----------
# Set to 1 to also ask for confirmation before creating calendar events.
# (Messages, cancellations and deletions always ask.)
CONFIRM_EVENTS=0
